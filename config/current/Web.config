<?xml version="1.0" encoding="utf-8"?>
<!--
  Used ONLY by the "current" pipeline (scripts/current/copy-config.ps1) to show today's pattern:
  a full config file per server kept in Git, with a value that should be a secret.
  The value below is fake. Never put real secrets in a repository.
-->
<configuration>
  <appSettings>
    <add key="Environment" value="Current pipeline" />
    <add key="ApiKey" value="fake-demo-key-123" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
